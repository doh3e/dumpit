<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application>
        <receiver
            android:name="kr.dumpit.widget.TodayTasksWidgetReceiver"
            android:exported="true"
            android:label="오늘 할 일">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_tasks_widget_info" />
        </receiver>
        <receiver
            android:name="kr.dumpit.widget.PomodoroWidgetReceiver"
            android:exported="true"
            android:label="뽀모도로">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pomodoro_widget_info" />
        </receiver>
        <receiver
            android:name="kr.dumpit.widget.WidgetTickReceiver"
            android:exported="false" />
        <service
            android:name="kr.dumpit.widget.PomodoroCommandService"
            android:exported="false" />
    </application>
</manifest>
